# Large files / archives
*.zip
*.rar
*.7z
*.tar
*.gz

# Dependencies
node_modules/
**/node_modules/
vendor/
**/vendor/

# Environment and sensitive files
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Build and cache
dist/
**/dist/
dist-ssr/
**/dist-ssr/
build/
**/build/
.phpunit.result.cache
**/.phpunit.result.cache

# Logs
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Laravel specific storage
**/storage/framework/cache/data/*
**/storage/framework/sessions/*
**/storage/framework/views/*
**/storage/framework/testing/*
**/storage/logs/*
**/storage/*.key
!**/storage/framework/cache/data/.gitignore
!**/storage/framework/sessions/.gitignore
!**/storage/framework/views/.gitignore
!**/storage/framework/testing/.gitignore
!**/storage/logs/.gitignore

# IDE and OS files
.DS_Store
Thumbs.db
.idea/
**/.idea/
.vscode/
**/.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
